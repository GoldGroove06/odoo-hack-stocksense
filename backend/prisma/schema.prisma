generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(WAREHOUSE_STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

// -----------------------------------------------------------------------------
// Product & Master Data Models
// -----------------------------------------------------------------------------

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model UnitOfMeasure {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  symbol    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Warehouse {
  id        Int        @id @default(autoincrement())
  name      String
  shortcode String     @unique
  address   String?
  manager   String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  locations Location[]
}

model Location {
  id          Int        @id @default(autoincrement())
  name        String
  shortcode   String     @unique
  address     String?
  type        String?    @default("Internal Storage")
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  sku           String         @unique
  description   String?
  perUnitCost   Float          @default(0.0)
  onHand        Float          @default(0.0)
  freeToUse     Float          @default(0.0)
  minStockAlert Float          @default(10.0)
  categoryId    Int?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uomId         Int?
  uom           UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  locationId    Int?
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}