generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum ProductKind {
  TRADING
  MANUFACTURING
}

enum MaterialType {
  RAW_MATERIAL
  FINISHED_GOODS
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String
  gstNumber String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  role              Role               @default(WAREHOUSE_STAFF)
  companyId         Int?
  company           Company?           @relation(fields: [companyId], references: [id])
  mustResetPassword Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  passwordResetOtps PasswordResetOtp[]
  transfersStaff    Transfer[]         @relation("TransferStaff")
  stockMovements    StockMovement[]
}

model PasswordResetOtp {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// -----------------------------------------------------------------------------
// Product & Master Data Models
// -----------------------------------------------------------------------------

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model UnitOfMeasure {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  symbol    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Warehouse {
  id         Int        @id @default(autoincrement())
  name       String
  shortcode  String     @unique
  address    String?
  manager    String?
  phone      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  locations  Location[]
  receipts   Receipt[]
  deliveries Delivery[]
}

model Location {
  id                 Int            @id @default(autoincrement())
  name               String
  shortcode          String         @unique
  address            String?
  type               String?        @default("Internal Storage")
  warehouseId        Int?
  warehouse          Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  products           Product[]
  stockQuants        StockQuant[]
  fromTransfers      Transfer[]     @relation("FromLocation")
  toTransfers        Transfer[]     @relation("ToLocation")
  adjustments        Adjustment[]
  receiptDestinations Receipt[]     @relation("ReceiptDestination")
  deliverySources    Delivery[]     @relation("DeliverySource")
  movementsFrom      StockMovement[] @relation("MovementFrom")
  movementsTo        StockMovement[] @relation("MovementTo")
}

model Supplier {
  id            Int       @id @default(autoincrement())
  name          String
  address       String?
  gstNumber     String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  receipts      Receipt[]
}

model Customer {
  id            Int        @id @default(autoincrement())
  name          String
  address       String?
  gstNumber     String?
  phone         String?
  email         String?
  contactPerson String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deliveries    Delivery[]
}

model Product {
  id              Int              @id @default(autoincrement())
  name            String
  sku             String           @unique
  description     String?
  perUnitCost     Float            @default(0.0)
  onHand          Float            @default(0.0)
  freeToUse       Float            @default(0.0)
  minStockAlert   Float            @default(10.0)
  productKind     ProductKind      @default(TRADING)
  materialType    MaterialType     @default(FINISHED_GOODS)
  categoryId      Int?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uomId           Int?
  uom             UnitOfMeasure?   @relation(fields: [uomId], references: [id], onDelete: SetNull)
  locationId      Int?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  receiptItems    ReceiptItem[]
  deliveryItems   DeliveryItem[]
  transferItems   TransferItem[]
  adjustmentItems AdjustmentItem[]
  movements       StockMovement[]
  stockQuants     StockQuant[]
  bomAsParent     BomLine[]        @relation("BomParent")
  bomAsComponent  BomLine[]        @relation("BomComponent")
}

model BomLine {
  id                 Int     @id @default(autoincrement())
  parentProductId    Int
  parentProduct      Product @relation("BomParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentProductId Int
  componentProduct   Product @relation("BomComponent", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantity           Float   @default(1.0)

  @@unique([parentProductId, componentProductId])
}

model StockQuant {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId  Int
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity    Float    @default(0.0)
  reservedQty Float    @default(0.0)
  updatedAt   DateTime @updatedAt

  @@unique([productId, locationId])
}

// -----------------------------------------------------------------------------
// Inventory Operations: Receipts (WH/IN)
// -----------------------------------------------------------------------------

model Receipt {
  id                   Int           @id @default(autoincrement())
  reference            String        @unique
  status               String        @default("draft")
  scheduledDate        String?
  receiveFrom          String?
  responsible          String?       @default("Rohit Maurya")
  sellerBillNumber     String?
  sourceDocument       String?
  internalNotes        String?
  subtotal             Float         @default(0.0)
  taxRate              Float         @default(18.0)
  taxAmount            Float         @default(0.0)
  totalAmount          Float         @default(0.0)
  supplierId           Int?
  supplier             Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouseId          Int?
  warehouse            Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  destinationLocationId Int?
  destinationLocation  Location?     @relation("ReceiptDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  moNumber             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  items                ReceiptItem[]
  transfers            Transfer[]
}

model ReceiptItem {
  id          Int      @id @default(autoincrement())
  receiptId   Int
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  sku         String?
  quantity    Float    @default(1.0)
  receivedQty Float    @default(0.0)
  unitCost    Float    @default(0.0)
  totalPrice  Float    @default(0.0)
  unit        String   @default("Units")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Inventory Operations: Deliveries (WH/OUT)
// -----------------------------------------------------------------------------

model Delivery {
  id               Int            @id @default(autoincrement())
  reference        String         @unique
  status           String         @default("draft")
  scheduledDate    String?
  destination      String?
  responsible      String?        @default("Rohit Maurya")
  carrier          String?        @default("Internal Logistics")
  trackingNumber   String?
  vehicleNumber    String?
  sourceDocument   String?
  customerNotes    String?
  subtotal         Float          @default(0.0)
  taxRate          Float          @default(18.0)
  taxAmount        Float          @default(0.0)
  totalAmount      Float          @default(0.0)
  customerId       Int?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  warehouseId      Int?
  warehouse        Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sourceLocationId Int?
  sourceLocation   Location?      @relation("DeliverySource", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  moNumber         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            DeliveryItem[]
  transfers        Transfer[]
}

model DeliveryItem {
  id           Int      @id @default(autoincrement())
  deliveryId   Int
  delivery     Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  sku          String?
  quantity     Float    @default(1.0)
  deliveredQty Float    @default(0.0)
  unitCost     Float    @default(0.0)
  totalPrice   Float    @default(0.0)
  unit         String   @default("Units")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Inventory Operations: Internal Transfers / Movements
// -----------------------------------------------------------------------------

model Transfer {
  id             Int            @id @default(autoincrement())
  reference      String         @unique
  status         String         @default("draft")
  scheduledDate  String?
  fromLocationId Int?
  fromLocation   Location?      @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   Int?
  toLocation     Location?      @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  notes          String?
  isManufactured Boolean        @default(false)
  moNumber       String?
  responsible    String?        @default("Rohit Maurya")
  receiptId      Int?
  receipt        Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  deliveryId     Int?
  delivery       Delivery?      @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  staffUserId    Int?
  staffUser      User?          @relation("TransferStaff", fields: [staffUserId], references: [id], onDelete: SetNull)
  pickedAt       DateTime?
  droppedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          TransferItem[]
}

model TransferItem {
  id             Int      @id @default(autoincrement())
  transferId     Int
  transfer       Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  sku            String?
  quantity       Float    @default(1.0)
  pickedQty      Float    @default(0.0)
  transferredQty Float    @default(0.0)
  unit           String   @default("Units")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Inventory Operations: Adjustments (Physical Inventory)
// -----------------------------------------------------------------------------

model Adjustment {
  id               Int              @id @default(autoincrement())
  reference        String           @unique
  status           String           @default("draft")
  countedDate      String?
  locationId       Int?
  location         Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reason           String?          @default("Annual Physical Count")
  responsible      String?          @default("Rohit Maurya")
  notes            String?
  totalItems       Int              @default(0)
  netVarianceQty   Float            @default(0.0)
  netVarianceValue Float            @default(0.0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            AdjustmentItem[]
}

model AdjustmentItem {
  id             Int        @id @default(autoincrement())
  adjustmentId   Int
  adjustment     Adjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId      Int?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  sku            String?
  theoreticalQty Float      @default(0.0)
  countedQty     Float      @default(0.0)
  variance       Float      @default(0.0)
  perUnitCost    Float      @default(0.0)
  varianceValue  Float      @default(0.0)
  unit           String     @default("Units")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// -----------------------------------------------------------------------------
// Stock Ledger & Movements Audit History
// -----------------------------------------------------------------------------

model StockMovement {
  id             Int       @id @default(autoincrement())
  reference      String
  type           String
  productId      Int?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  sku            String?
  fromLocation   String?
  toLocation     String?
  fromLocationId Int?
  fromLoc        Location? @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   Int?
  toLoc          Location? @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  quantity       Float
  unit           String    @default("Units")
  balanceAfter   Float?
  reason         String?
  responsible    String?   @default("Rohit Maurya")
  userId         Int?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentType   String?
  documentId     Int?
  createdAt      DateTime  @default(now())
}
